# SMTP voor het contactformulier: dezelfde mailbox als fynnworks.
# Kopieer naar .env.local voor lokaal testen. Op de Pi staan deze regels in
# /etc/portfolio.env (chmod 600) — zie deploy/DEPLOY.md.
SMTP_HOST=smtp.hostnet.nl
SMTP_PORT=587
SMTP_USER=info@fynnworks.nl
SMTP_PASS=<wachtwoord van de mailbox>
